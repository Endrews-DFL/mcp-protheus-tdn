# ==========================================================================
# Conector MCP -> Protheus (TOTVS) da DFL. Copie para ".env" e preencha.
# NUNCA versione o .env (já está no .gitignore).
# ==========================================================================

# --- Protheus REST --------------------------------------------------------
# Base REST (inclui o ambiente /rest/03).
PROTHEUS_BASE_URL=https://dflindustria141981.protheus.cloudtotvs.com.br:1916/rest/03

# Credenciais OAuth2 (password grant). Use um USUÁRIO DE SERVIÇO SÓ-LEITURA.
PROTHEUS_USER=
PROTHEUS_PASSWORD=

# Empresa,Filial (tenantId). Ambiente 03 = empresa 03; filial 01.
PROTHEUS_TENANT_ID=03,01

# Token de aplicação dos WS customizados (MV DFL_TOKEN). Opcional.
PROTHEUS_DFL_TOKEN=

# --- Transporte MCP -------------------------------------------------------
# "stdio" (local / Inspector) ou "http" (hospedado / Coolify).
MCP_TRANSPORT=stdio
HTTP_PORT=8080
HTTP_PATH=/mcp

# Segredo do CONECTOR (usado só quando AUTH_MODE != oauth). Protege o endpoint MCP
# via header "Authorization: Bearer <valor>" ou "x-connector-key: <valor>".
CONNECTOR_API_KEY=

# --- Autenticação por OAuth (login Microsoft/Entra + allowlist) --------------
# AUTH_MODE=oauth ativa o login por pessoa. Deixe "none" para usar CONNECTOR_API_KEY.
AUTH_MODE=none

# URL pública HTTPS do conector (sem barra no fim), ex.: https://protheus-mcp.seudominio.com.br
PUBLIC_URL=

# App Registration no Microsoft Entra (Azure AD)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Quem pode usar o conector (pelo menos um dos dois). CSV, minúsculo.
# Domínios liberam todos os e-mails do domínio; emails liberam pessoas específicas.
OAUTH_ALLOWED_DOMAINS=dfl.com.br
OAUTH_ALLOWED_EMAILS=

# Segredo para assinar os tokens emitidos pelo conector (gere com: openssl rand -hex 32)
OAUTH_JWT_SECRET=
