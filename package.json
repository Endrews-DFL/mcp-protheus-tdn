{
  "name": "protheus-mcp-server",
  "version": "0.1.0",
  "description": "Conector MCP somente-leitura para consulta ao Protheus (TOTVS) da DFL — piloto de 10 endpoints.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "protheus-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "cross-env MCP_TRANSPORT=stdio node dist/index.js",
    "start:http": "cross-env MCP_TRANSPORT=http node dist/index.js",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["mcp", "model-context-protocol", "protheus", "totvs", "claude", "connector"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.2"
  }
}
